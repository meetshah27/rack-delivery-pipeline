# Copy to .env and fill in. .env is gitignored; never commit real values.
AWS_PROFILE=bie-portfolio
AWS_REGION=us-west-2
PROJECT_BUCKET=
REDSHIFT_WORKGROUP=
REDSHIFT_DATABASE=
# Workgroup endpoint host for dbt IAM auth (Terraform output, Phase 2).
REDSHIFT_HOST=
# QuickSight user ARN of the owner; needed from Phase 7.
QS_OWNER_ARN=
# Email for SNS pipeline alerts; needed from Phase 6.
ALERT_EMAIL=
