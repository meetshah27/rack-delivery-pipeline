# Copy to .env and fill in. .env is gitignored; never commit real values.
AWS_PROFILE=bie-portfolio
AWS_REGION=us-west-2
# Email for SNS pipeline alerts; confirm the subscription email after tf-apply.
ALERT_EMAIL=
# Your public IP as a /32, so dbt show and checks can reach Redshift; leave empty for none.
OPERATOR_CIDR=

# From `terraform -chdir=infra/envs/dev output` after tf-apply (dbt profile `dev`).
REDSHIFT_HOST=
REDSHIFT_WORKGROUP=
REDSHIFT_DATABASE=dev

# Phase 7, after subscribing to QuickSight Enterprise in us-west-2.
QS_ENABLED=false
QS_OWNER_ARN=
QS_OWNER_USER_NAME=
# Two reader users for the row-level security check (plus-addresses are fine).
RLS_READER_EMAIL_US_WEST=
RLS_READER_EMAIL_AP_SOUTH=
