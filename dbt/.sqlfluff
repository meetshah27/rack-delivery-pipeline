[sqlfluff]
dialect = redshift
templater = dbt
max_line_length = 100
# AM02 would rewrite UNION as UNION DISTINCT, which Redshift does not accept.
exclude_rules = ambiguous.union

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
target = local

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:references.keywords]
# Column names fixed by docs/DATA_MODEL.md and the P3 golden queries.
ignore_words = date,year,quarter,month,stage
